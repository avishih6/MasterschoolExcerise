        "pg": "^8.13.1"
    },
    "devDependencies": {
        "@google-cloud/translate": "^7.1.0",
        "@types/amqplib": "^0.10.1",
        "@types/lodash": "^4.17.14",
        "@types/mongodb": "^4.0.7",
        "@types/pg": "^8.11.11",
        "ts-node": "^10.9.1",
        "typescript": "^4.9.5"
