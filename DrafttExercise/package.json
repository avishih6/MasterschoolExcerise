{
    "name": "draftt-interview",
    "version": "1.0.0",
    "description": "draftt-interview",
    "main": "main.js",
    "bin": {
        "cityStreets": "./dist/main.js"
    },
    "scripts": {
        "build": "tsc",
        "build:watch": "tsc --watch",
        "start": "node dist/main.js",
